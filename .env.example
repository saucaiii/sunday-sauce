# Copy this file to .env and fill in the values your project needs.
# .env is ignored by .gitignore. Never commit real secrets.
# Agents cannot read .env* at all (see .agent-policy/policy.sh); refer to secrets
# by variable name only in prompts, plans, and PRs.

# Fine-grained GitHub PAT for Claude Code's GitHub MCP server.
# Scope: this repo only, read-only.
# GITHUB_MCP_PAT=

# GitHub PAT for Copilot's GitHub MCP server.
# Stored as a secret in the repo's "copilot" environment, not here.
# COPILOT_MCP_GITHUB_PERSONAL_ACCESS_TOKEN=

# PAT with "Copilot Requests" scope, used by .github/workflows/agent-ci.yml.
# Stored as an Actions secret.
# COPILOT_CLI_TOKEN=

# ── OBS overlay ────────────────────────────────────────────────────────────
# The overlay is served at /overlay/<OVERLAY_SECRET>/ and its state at
# .../state. The secret is a path segment, not a query parameter, and the URL
# should be treated as a credential: anyone holding it can read the endpoint.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OVERLAY_SECRET=
# Loopback by default. Put a tunnel or a reverse proxy in front rather than
# binding this to a public interface.
OVERLAY_HOST=127.0.0.1
OVERLAY_PORT=8787
# Seconds between upstream price refreshes.
PRICE_CACHE_SECONDS=30
# Seconds before cached prices are reported stale in the payload.
OVERLAY_STALE_SECONDS=120
# Serve fixture data and make no upstream calls. For working on the overlay.
OVERLAY_FIXTURES=0

# The headline ticker shows what the Telegram channel published. Those jobs
# live in tg-broadcast on the droplet, so the server pulls their ledger over
# SSH (read-only, no port opened). Empty means no live headlines.
HEADLINE_SYNC_HOST=
HEADLINE_SYNC_PATH=/opt/tg-broadcast/data/headlines.json
HEADLINE_SYNC_MINUTES=5

# ── OBS control ────────────────────────────────────────────────────────────
# Lets the control page cut scenes over obs-websocket. URL and password are
# read from OBS's own websocket config when these are empty.
OBS_CONTROL=1
OBS_WS_URL=
OBS_WS_PASSWORD=
# Return to the previous scene when an ad read ends.
OBS_AUTO_RETURN=1
